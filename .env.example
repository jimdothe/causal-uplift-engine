# Copy to .env and fill in. Never commit .env.
SNOWFLAKE_ACCOUNT=orgname-accountname
SNOWFLAKE_USER=your_user
# Use key-pair auth (path to your private key file, kept outside the repo)
SNOWFLAKE_PRIVATE_KEY_PATH=/path/outside/repo/rsa_key.p8
SNOWFLAKE_ROLE=UPLIFT_DEV
SNOWFLAKE_WAREHOUSE=UPLIFT_WH
SNOWFLAKE_DATABASE=CAUSAL_UPLIFT

# Where raw Parquet and snapshots live (college storage on the GPU server)
DATA_DIR=./data
OUTPUT_DIR=./outputs

WANDB_PROJECT=causal-uplift-engine
